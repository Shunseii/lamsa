#!/usr/bin/env node
// A stand-in for Claude Code in tests: same flags, same stream-json and session files, no network.
// What it does depends on the prompt: "fail" fails the turn, "slow" keeps working until stopped,
// "edit" changes a design file, anything else gets a short streamed reply.
import { appendFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { randomUUID } from "node:crypto";

const args = process.argv.slice(2);
const projectsDir = process.env.FAKE_CLAUDE_PROJECTS ?? join(process.cwd(), ".fake-claude-projects");
const option = (name) => {
  const at = args.indexOf(name);
  return at >= 0 ? args[at + 1] : undefined;
};

if (args[0] === "--version") {
  console.log("9.9.9 (Claude Code)");
  process.exit(0);
}
if (args[0] === "auth" && args[1] === "status") {
  const signedOut = existsSync(join(projectsDir, "..", "signed-out"));
  console.log(JSON.stringify({ loggedIn: !signedOut, authMethod: "claude.ai", projectsDirectory: projectsDir }));
  process.exit(signedOut ? 1 : 0);
}

const sessionId = option("--session-id") ?? option("--resume") ?? randomUUID();
const sessionFile = join(projectsDir, process.cwd().replace(/[^a-zA-Z0-9]/g, "-"), `${sessionId}.jsonl`);
const record = (type, content) => {
  mkdirSync(dirname(sessionFile), { recursive: true });
  const message = type === "user" ? { role: "user", content } : { id: `msg_${randomUUID()}`, role: "assistant", type: "message", content };
  appendFileSync(sessionFile, `${JSON.stringify({ type, isSidechain: false, message, uuid: randomUUID(), timestamp: new Date().toISOString(), cwd: process.cwd(), sessionId })}\n`);
};
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

if (!args.includes("-p")) {
  // Interactive, as opened in the user's terminal: say something there, then the user closes it.
  record("user", "Hello from the terminal");
  record("assistant", [{ type: "text", text: "Hi! Picked up in the terminal." }]);
  await sleep(Number(process.env.FAKE_CLAUDE_TERMINAL_MS ?? 1500));
  process.exit(0);
}

if (option("--resume") && !existsSync(sessionFile)) {
  console.error(`No conversation found with session ID: ${sessionId}`);
  process.exit(1);
}

let prompt = "";
for await (const chunk of process.stdin) prompt += chunk;
prompt = prompt.trim();
record("user", prompt);

const emit = (value) => process.stdout.write(`${JSON.stringify({ session_id: sessionId, ...value })}\n`);
let messages = 0;
async function say(text) {
  const id = `msg_${++messages}_${randomUUID().slice(0, 8)}`;
  emit({ type: "stream_event", event: { type: "message_start", message: { id, role: "assistant", content: [] } }, parent_tool_use_id: null });
  emit({ type: "stream_event", event: { type: "content_block_start", index: 0, content_block: { type: "text", text: "" } }, parent_tool_use_id: null });
  for (const word of text.split(/(?<= )/)) {
    emit({ type: "stream_event", event: { type: "content_block_delta", index: 0, delta: { type: "text_delta", text: word } }, parent_tool_use_id: null });
    await sleep(15);
  }
  emit({ type: "assistant", message: { id, role: "assistant", content: [{ type: "text", text }] }, parent_tool_use_id: null, uuid: randomUUID() });
  record("assistant", [{ type: "text", text }]);
}
async function tool(name, input, run) {
  const id = `toolu_${randomUUID().slice(0, 12)}`;
  const messageId = `msg_${++messages}`;
  emit({ type: "stream_event", event: { type: "message_start", message: { id: messageId, role: "assistant", content: [] } }, parent_tool_use_id: null });
  emit({ type: "stream_event", event: { type: "content_block_start", index: 0, content_block: { type: "tool_use", id, name, input: {} } }, parent_tool_use_id: null });
  emit({ type: "assistant", message: { id: messageId, role: "assistant", content: [{ type: "tool_use", id, name, input }] }, parent_tool_use_id: null, uuid: randomUUID() });
  record("assistant", [{ type: "tool_use", id, name, input }]);
  const output = await run();
  emit({ type: "user", message: { role: "user", content: [{ tool_use_id: id, type: "tool_result", content: output, is_error: false }] }, parent_tool_use_id: null, uuid: randomUUID() });
  record("user", [{ tool_use_id: id, type: "tool_result", content: output, is_error: false }]);
}
const result = (fields) => emit({ type: "result", subtype: "success", is_error: false, duration_ms: 10, num_turns: 1, ...fields });

emit({ type: "system", subtype: "init", cwd: process.cwd(), model: "fake", tools: ["Bash", "Edit"] });

if (/fail/i.test(prompt)) {
  result({ is_error: true, result: "Claude AI usage limit reached, resets at 4:00 pm. Nothing was changed." });
  process.exit(1);
}

if (/slow/i.test(prompt)) {
  process.on("SIGINT", () => {
    record("user", "[Request interrupted by user]");
    process.exit(130);
  });
  await say("Working on it ");
  await sleep(60_000);
  process.exit(0);
}

if (/clean/i.test(prompt)) {
  // A command outside lamsa's default permissions: refused unless the chat allowed it.
  const rule = "Bash(rm -rf build)";
  const allowed = args.includes(rule);
  const id = "toolu_blocked";
  emit({ type: "assistant", message: { id: "msg_blocked", role: "assistant", content: [{ type: "tool_use", id, name: "Bash", input: { command: "rm -rf build" } }] }, parent_tool_use_id: null, uuid: randomUUID() });
  const output = allowed ? "" : "Claude requested permissions to use Bash, but you haven't granted it yet.";
  emit({ type: "user", message: { role: "user", content: [{ tool_use_id: id, type: "tool_result", content: output, is_error: !allowed }] }, parent_tool_use_id: null, uuid: randomUUID() });
  await say(allowed ? "Cleaned the build folder." : "I wasn't allowed to remove the build folder.");
  result({ permission_denials: allowed ? [] : [{ tool_name: "Bash", tool_use_id: id, tool_input: { command: "rm -rf build" } }] });
  process.exit(0);
}

if (/edit/i.test(prompt)) {
  await say("Updating the checkout title.");
  const file = join(process.cwd(), "designs/checkout.lamsa.json");
  await tool("Edit", { file_path: file, old_string: "Checkout", new_string: "Checkout (by agent)" }, async () => {
    const design = JSON.parse(readFileSync(file, "utf8"));
    design.nodes.gmrdFHB9.content = "Checkout (by agent)";
    writeFileSync(file, JSON.stringify(design, null, 2));
    await sleep(400);
    return "The file has been updated.";
  });
  await tool("Bash", { command: "lamsa validate" }, async () => "valid · 2 file(s)");
  await say("Done. The title now reads “Checkout (by agent)”.");
  result({ result: "Done." });
  process.exit(0);
}

await say(`You said: ${prompt}`);
result({ result: `You said: ${prompt}` });
