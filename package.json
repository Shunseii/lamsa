{
  "name": "lamsa-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm build && vitest run",
    "test:unit": "vitest run tests/core.test.ts tests/renderer.test.ts tests/cli.test.ts",
    "typecheck": "pnpm -r typecheck",
    "desktop": "pnpm --filter @lamsa/desktop dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "@lamsa/core": "workspace:*",
    "@lamsa/renderer": "workspace:*",
    "@lamsa/schema": "workspace:*",
    "playwright-core": "^1.65.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  }
}
