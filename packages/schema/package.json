{
  "name": "@lamsa/schema",
  "version": "0.1.0",
  "description": "Types and JSON Schema for lamsa design files",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schema.json": "./dist/lamsa.schema.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node scripts/emit-json-schema.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "zod": "^4.1.0"
  }
}
