{
  "name": "@lamsa/cli",
  "version": "0.1.0",
  "description": "Local-first design files for apps, driven by your own coding agent",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "design",
    "design-tool",
    "ui",
    "agents",
    "claude-code",
    "shadcn",
    "tailwind",
    "cli"
  ],
  "homepage": "https://github.com/Shunseii/lamsa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shunseii/lamsa.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Shunseii/lamsa/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lamsa": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skill"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "commander": "^14.0.0",
    "fractional-indexing": "^3.2.0",
    "lucide-static": "^1.71.0",
    "nanoid": "^5.1.0",
    "picomatch": "^4.0.7",
    "playwright-core": "^1.65.0",
    "postcss": "^8.5.0",
    "tailwindcss": "4.3.5",
    "tinyglobby": "^0.2.10",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@lamsa/core": "workspace:*",
    "@lamsa/renderer": "workspace:*",
    "@lamsa/schema": "workspace:*"
  }
}
