{
  "name": "@lamsa/renderer",
  "version": "0.1.0",
  "description": "Render lamsa design JSON to DOM/CSS",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@lamsa/schema": "workspace:*"
  }
}
